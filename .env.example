# NUOrder Backend Environment Configuration Example
# Copy this file to .env and configure your LLM provider credentials.
# NEVER commit .env to version control.

PORT=5000

# Provider options: 'gemini' | 'openai' | 'groq' | 'anthropic' | 'mock'
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-flash
